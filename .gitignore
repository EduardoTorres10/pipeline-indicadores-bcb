# Credenciais — NUNCA versionar
.env
include/gcp/*
!include/gcp/.gitkeep
*service_account*.json
*service-account*.json
gcp-key*.json
portfolio-dados-*.json

# Power BI (formato PBIP): cache local e configurações da máquina
**/.pbi/localSettings.json
**/.pbi/cache.abf

# dbt
dbt/target/
dbt/dbt_packages/
dbt/logs/
dbt/.user.yml

# Airflow / Astro
.astro/*
!.astro/config.yaml
airflow_settings.yaml
logs/

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# SO / IDE
.DS_Store
.vscode/
.idea/
.ruff_cache/
