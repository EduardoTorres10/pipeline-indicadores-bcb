/// Dimensão de datas (tabela de datas do modelo).
table dim_calendario
	dataCategory: Time

	column data
		dataType: dateTime
		isKey
		formatString: Short Date
		summarizeBy: none
		sourceColumn: data

		annotation UnderlyingDateTimeDataType = Date

	column ano
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: ano

	column trimestre
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: trimestre

	column ano_trimestre
		dataType: string
		summarizeBy: none
		sourceColumn: ano_trimestre

	column mes_numero
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: mes_numero

	column mes_nome
		dataType: string
		sortByColumn: mes_numero
		summarizeBy: none
		sourceColumn: mes_nome

	column mes_ano
		dataType: string
		sortByColumn: mes_ano_ordem
		summarizeBy: none
		sourceColumn: mes_ano

	column mes_ano_ordem
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: mes_ano_ordem

	column inicio_mes
		dataType: dateTime
		formatString: mmm/yyyy
		summarizeBy: none
		sourceColumn: inicio_mes

		annotation UnderlyingDateTimeDataType = Date

	column dia_semana_numero
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: dia_semana_numero

	column dia_semana_nome
		dataType: string
		sortByColumn: dia_semana_numero
		summarizeBy: none
		sourceColumn: dia_semana_nome

	column fim_de_semana
		dataType: boolean
		formatString: """Sim"";""Sim"";""Não"""
		summarizeBy: none
		sourceColumn: fim_de_semana

	partition dim_calendario = m
		mode: import
		source = ```
				let
					Fonte = GoogleBigQuery.Database([BillingProject = "portfolio-dados-512321", UseStorageApi = false]),
					Projeto = Fonte{[Name = "portfolio-dados-512321"]}[Data],
					Marts = Projeto{[Name = "marts", Kind = "Schema"]}[Data],
					Tabela = Marts{[Name = "dim_calendario", Kind = "Table"]}[Data],
					Tipos = Table.TransformColumnTypes(
						Tabela,
						{
							{"data", type date},
							{"ano", Int64.Type},
							{"trimestre", Int64.Type},
							{"ano_trimestre", type text},
							{"mes_numero", Int64.Type},
							{"mes_nome", type text},
							{"mes_ano", type text},
							{"mes_ano_ordem", Int64.Type},
							{"inicio_mes", type date},
							{"dia_semana_numero", Int64.Type},
							{"dia_semana_nome", type text},
							{"fim_de_semana", type logical}
						}
					)
				in
					Tipos
			```

