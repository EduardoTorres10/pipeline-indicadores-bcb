        },
        {
          "name": "fundo_visao_geral.png",
          "path": "fundo_visao_geral.png",
          "type": "Image"
        },
        {
          "name": "fundo_cambio.png",
          "path": "fundo_cambio.png",
          "type": "Image"
        },
        {
          "name": "fundo_inflacao.png",
          "path": "fundo_inflacao.png",
          "type": "Image"
        }
      ]
    }
  ],
  "settings": {
    "useStylableVisualContainerHeader": true,
    "exportDataMode": "AllowSummarized",
    "defaultDrillFilterOtherVisuals": true,
