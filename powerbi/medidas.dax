// Medidas do relatório (gerado a partir do modelo TMDL).

// [Taxas] Meta Selic vigente no último dia do período filtrado.
Selic Meta =
VAR UltimaData =
    CALCULATE ( MAX ( fct_indicadores_diarios[data] ) )
RETURN
    DIVIDE (
        CALCULATE (
            MAX ( fct_indicadores_diarios[selic_meta_aa] ),
            fct_indicadores_diarios[data] = UltimaData
        ),
        100
    )

// [Taxas] Selic média do mês contra o IPCA 12 meses (Fisher), no último mês com valor.
Juro Real Ex-Post =
VAR UltimoMes =
    CALCULATE (
        MAX ( fct_inflacao_juro_real_mensal[mes] ),
        NOT ISBLANK ( fct_inflacao_juro_real_mensal[juro_real_ex_post_aa] )
    )
RETURN
    DIVIDE (
        CALCULATE (
            MAX ( fct_inflacao_juro_real_mensal[juro_real_ex_post_aa] ),
            fct_inflacao_juro_real_mensal[mes] = UltimoMes
        ),
        100
    )

// [Inflação] IPCA acumulado em 12 meses no último mês com valor do período.
IPCA 12 Meses =
VAR UltimoMes =
    CALCULATE (
        MAX ( fct_inflacao_juro_real_mensal[mes] ),
        NOT ISBLANK ( fct_inflacao_juro_real_mensal[ipca_12m_pct] )
    )
RETURN
    DIVIDE (
        CALCULATE (
            MAX ( fct_inflacao_juro_real_mensal[ipca_12m_pct] ),
            fct_inflacao_juro_real_mensal[mes] = UltimoMes
        ),
        100
    )

// [Inflação] IPCA do mês; com vários meses no contexto, devolve o do último.
IPCA Mensal =
VAR UltimoMes =
    MAX ( fct_inflacao_juro_real_mensal[mes] )
RETURN
    DIVIDE (
        CALCULATE (
            MAX ( fct_inflacao_juro_real_mensal[ipca_mensal_pct] ),
            fct_inflacao_juro_real_mensal[mes] = UltimoMes
        ),
        100
    )

// [Inflação] Inflação composta de todos os meses do período: produto de (1 + taxa) - 1.
IPCA Acumulado no Período =
VAR Meses =
    COUNTROWS ( fct_inflacao_juro_real_mensal )
VAR Fator =
    PRODUCTX (
        fct_inflacao_juro_real_mensal,
        1 + fct_inflacao_juro_real_mensal[ipca_mensal_pct] / 100
    )
RETURN
    IF ( Meses > 0, Fator - 1 )

// [Inflação] Para a matriz ano x mês: IPCA do mês nas células e acumulado do ano/período nos totais.
IPCA Matriz =
IF (
    ISINSCOPE ( dim_calendario[mes_nome] ),
    [IPCA Mensal],
    [IPCA Acumulado no Período]
)

// [Câmbio] Cotação no último dia do período (repete a última cotação em fins de semana).
Dólar Fechamento =
VAR UltimaData =
    CALCULATE ( MAX ( fct_indicadores_diarios[data] ) )
RETURN
    CALCULATE (
        MAX ( fct_indicadores_diarios[dolar_venda] ),
        fct_indicadores_diarios[data] = UltimaData
    )

// [Câmbio] Cotação no primeiro dia do período.
Dólar Abertura =
VAR PrimeiraData =
    CALCULATE ( MIN ( fct_indicadores_diarios[data] ) )
RETURN
    CALCULATE (
        MAX ( fct_indicadores_diarios[dolar_venda] ),
        fct_indicadores_diarios[data] = PrimeiraData
    )

// [Câmbio] Média só dos dias com cotação.
Dólar Médio =
CALCULATE (
    AVERAGE ( fct_indicadores_diarios[dolar_venda] ),
    fct_indicadores_diarios[dia_util] = TRUE ()
)

// [Câmbio] Média móvel de 21 dias úteis no último dia com cotação do período.
Dólar Média Móvel 21du =
VAR UltimaData =
    CALCULATE (
        MAX ( fct_indicadores_diarios[data] ),
        fct_indicadores_diarios[dia_util] = TRUE ()
    )
RETURN
    CALCULATE (
        MAX ( fct_indicadores_diarios[dolar_media_movel_21du] ),
        fct_indicadores_diarios[data] = UltimaData
    )

// [Câmbio] Variação % entre a abertura e o fechamento do período.
Dólar Variação no Período =
DIVIDE ( [Dólar Fechamento] - [Dólar Abertura], [Dólar Abertura] )

// [Taxas] Meta Selic exatamente 12 meses antes do último dia do período.
Selic Meta 12M Atrás =
VAR UltimaData =
    CALCULATE ( MAX ( fct_indicadores_diarios[data] ) )
VAR DataRef =
    EDATE ( UltimaData, -12 )
RETURN
    DIVIDE (
        CALCULATE (
            MAX ( fct_indicadores_diarios[selic_meta_aa] ),
            REMOVEFILTERS ( dim_calendario ),
            fct_indicadores_diarios[data] = DataRef
        ),
        100
    )

// [Inflação] IPCA 12 meses no mesmo mês do ano anterior.
IPCA 12 Meses 12M Atrás =
VAR UltimoMes =
    CALCULATE (
        MAX ( fct_inflacao_juro_real_mensal[mes] ),
        NOT ISBLANK ( fct_inflacao_juro_real_mensal[ipca_12m_pct] )
    )
VAR MesRef =
    EDATE ( UltimoMes, -12 )
RETURN
    DIVIDE (
        CALCULATE (
            MAX ( fct_inflacao_juro_real_mensal[ipca_12m_pct] ),
            REMOVEFILTERS ( dim_calendario ),
            fct_inflacao_juro_real_mensal[mes] = MesRef
        ),
        100
    )

// [Taxas] Juro real ex-post no mesmo mês do ano anterior.
Juro Real 12M Atrás =
VAR UltimoMes =
    CALCULATE (
        MAX ( fct_inflacao_juro_real_mensal[mes] ),
        NOT ISBLANK ( fct_inflacao_juro_real_mensal[juro_real_ex_post_aa] )
    )
VAR MesRef =
    EDATE ( UltimoMes, -12 )
RETURN
    DIVIDE (
        CALCULATE (
            MAX ( fct_inflacao_juro_real_mensal[juro_real_ex_post_aa] ),
            REMOVEFILTERS ( dim_calendario ),
            fct_inflacao_juro_real_mensal[mes] = MesRef
        ),
        100
    )

// [Câmbio] Cotação exatamente 12 meses antes do último dia do período.
Dólar 12M Atrás =
VAR UltimaData =
    CALCULATE ( MAX ( fct_indicadores_diarios[data] ) )
VAR DataRef =
    EDATE ( UltimaData, -12 )
RETURN
    CALCULATE (
        MAX ( fct_indicadores_diarios[dolar_venda] ),
        REMOVEFILTERS ( dim_calendario ),
        fct_indicadores_diarios[data] = DataRef
    )

// [Câmbio] Variação % do fechamento contra 12 meses antes.
Dólar Variação em 12 Meses =
DIVIDE ( [Dólar Fechamento] - [Dólar 12M Atrás], [Dólar 12M Atrás] )

// [Câmbio] Maior cotação do período.
Dólar Máximo =
CALCULATE (
    MAX ( fct_indicadores_diarios[dolar_venda] ),
    fct_indicadores_diarios[dia_util] = TRUE ()
)

// [Câmbio] Menor cotação do período.
Dólar Mínimo =
CALCULATE (
    MIN ( fct_indicadores_diarios[dolar_venda] ),
    fct_indicadores_diarios[dia_util] = TRUE ()
)

// [Inflação] Centro da meta do CMN para o ano (2025 em diante: meta contínua de 3%).
Meta de Inflação =
VAR Ano =
    MAX ( dim_calendario[ano] )
VAR Meta =
    SWITCH (
        TRUE (),
        Ano <= 2018, 4.5,
        Ano = 2019, 4.25,
        Ano = 2020, 4.0,
        Ano = 2021, 3.75,
        Ano = 2022, 3.5,
        Ano = 2023, 3.25,
        3.0
    )
RETURN
    IF ( NOT ISBLANK ( [IPCA 12 Meses] ), Meta / 100 )

// [Inflação] Intervalo de tolerância: 2 p.p. até 2016, 1,5 p.p. depois.
Tolerância da Meta =
VAR Ano =
    MAX ( dim_calendario[ano] )
RETURN
    IF ( NOT ISBLANK ( [Meta de Inflação] ), IF ( Ano <= 2016, 0.02, 0.015 ) )

// [Inflação] Limite superior da meta.
Teto da Meta =
IF ( NOT ISBLANK ( [Meta de Inflação] ), [Meta de Inflação] + [Tolerância da Meta] )

// [Inflação] Limite inferior da meta.
Piso da Meta =
IF ( NOT ISBLANK ( [Meta de Inflação] ), [Meta de Inflação] - [Tolerância da Meta] )

// [Inflação] Quantidade de meses do período com IPCA 12 meses acima do teto da meta.
Meses Acima do Teto =
COUNTROWS (
    FILTER (
        VALUES ( dim_calendario[inicio_mes] ),
        [IPCA 12 Meses] > [Teto da Meta]
    )
) + 0

// [Inflação] Escala máxima do velocímetro de inflação.
Gauge Máximo =
MAX ( 0.12, [IPCA 12 Meses] * 1.2 )

// [Tendência] Seta e variação em p.p. contra 12 meses atrás.
Selic Tendência =
VAR Atual = [Selic Meta]
VAR Ref = [Selic Meta 12M Atrás]
VAR Delta = Atual - Ref
RETURN
    IF (
        NOT ISBLANK ( Ref ),
        IF ( Delta > 0, "▲ ", IF ( Delta < 0, "▼ ", "■ " ) )
            & FORMAT ( ABS ( Delta ) * 100, "0.00" ) & " p.p. em 12 meses"
    )

// [Tendência] Seta e variação em p.p. contra 12 meses atrás.
IPCA Tendência =
VAR Atual = [IPCA 12 Meses]
VAR Ref = [IPCA 12 Meses 12M Atrás]
VAR Delta = Atual - Ref
RETURN
    IF (
        NOT ISBLANK ( Ref ),
        IF ( Delta > 0, "▲ ", IF ( Delta < 0, "▼ ", "■ " ) )
            & FORMAT ( ABS ( Delta ) * 100, "0.00" ) & " p.p. em 12 meses"
    )

// [Tendência] Seta e variação em p.p. contra 12 meses atrás.
Juro Real Tendência =
VAR Atual = [Juro Real Ex-Post]
VAR Ref = [Juro Real 12M Atrás]
VAR Delta = Atual - Ref
RETURN
    IF (
        NOT ISBLANK ( Ref ),
        IF ( Delta > 0, "▲ ", IF ( Delta < 0, "▼ ", "■ " ) )
            & FORMAT ( ABS ( Delta ) * 100, "0.00" ) & " p.p. em 12 meses"
    )

// [Tendência] Seta e variação % contra 12 meses atrás.
Dólar Tendência =
VAR Var12 = [Dólar Variação em 12 Meses]
RETURN
    IF (
        NOT ISBLANK ( Var12 ),
        IF ( Var12 > 0, "▲ ", IF ( Var12 < 0, "▼ ", "■ " ) )
            & FORMAT ( ABS ( Var12 ), "0.00%" ) & " em 12 meses"
    )

// [Tendência] Situação do IPCA 12 meses frente à meta.
Meta Status =
VAR Ipca = [IPCA 12 Meses]
RETURN
    SWITCH (
        TRUE (),
        ISBLANK ( Ipca ), BLANK (),
        Ipca > [Teto da Meta], "▲ Acima do teto da meta",
        Ipca < [Piso da Meta], "▼ Abaixo do piso da meta",
        "● Dentro do intervalo da meta"
    )

// [Cores] Âmbar quando a Selic sobe, verde-água quando cai.
Cor Selic =
VAR Delta = [Selic Meta] - [Selic Meta 12M Atrás]
RETURN
    SWITCH ( TRUE (), Delta > 0, "#FBBF24", Delta < 0, "#2DD4BF", "#94A3B8" )

// [Cores] Vermelho quando a inflação sobe, verde quando cai.
Cor IPCA =
VAR Delta = [IPCA 12 Meses] - [IPCA 12 Meses 12M Atrás]
RETURN
    SWITCH ( TRUE (), Delta > 0, "#F87171", Delta < 0, "#34D399", "#94A3B8" )

// [Cores] Verde quando o juro real sobe, vermelho quando cai.
Cor Juro Real =
VAR Delta = [Juro Real Ex-Post] - [Juro Real 12M Atrás]
RETURN
    SWITCH ( TRUE (), Delta > 0, "#34D399", Delta < 0, "#F87171", "#94A3B8" )

// [Cores] Vermelho quando o dólar sobe (real se desvaloriza), verde quando cai.
Cor Dólar =
VAR Var12 = [Dólar Variação em 12 Meses]
RETURN
    SWITCH ( TRUE (), Var12 > 0, "#F87171", Var12 < 0, "#34D399", "#94A3B8" )

// [Cores] Cor do status do IPCA frente à meta.
Cor Meta Status =
VAR Ipca = [IPCA 12 Meses]
RETURN
    SWITCH (
        TRUE (),
        Ipca > [Teto da Meta], "#F87171",
        Ipca < [Piso da Meta], "#FBBF24",
        "#34D399"
    )

// [Cores] Barras de juro real: verde se positivo, vermelho se negativo.
Cor Barra Juro Real =
IF ( [Juro Real Ex-Post] >= 0, "#34D399", "#F87171" )

// [Cores] Barras de variação do dólar: vermelho se subiu, verde se caiu.
Cor Barra Dólar =
IF ( [Dólar Variação no Período] >= 0, "#F87171", "#34D399" )

// [Cores] Barras de IPCA: verde se deflação, âmbar até 0,5%, vermelho acima.
Cor Barra IPCA =
VAR Ipca = [IPCA Mensal]
RETURN
    SWITCH ( TRUE (), Ipca < 0, "#34D399", Ipca <= 0.005, "#FBBF24", "#F87171" )

// [Rótulos] Texto com a data mais recente dos dados.
Rótulo Atualização =
"Dados até "
    & FORMAT (
        CALCULATE ( MAX ( fct_indicadores_diarios[data] ), REMOVEFILTERS ( dim_calendario ) ),
        "dd/mm/yyyy"
    )

